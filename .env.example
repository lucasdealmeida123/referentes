# Producción — copiar a .env en Coolify o definir como variables de entorno

# PostgreSQL (obligatorio: cambiar password)
POSTGRES_DB=elecciones
POSTGRES_USER=elecciones
POSTGRES_PASSWORD=cambiar-por-password-seguro

# Backend
DB_SYNCHRONIZE=false

# Frontend build: vacío = mismo dominio (nginx proxy /api → backend)
# Alternativa: URL pública del backend si lo exponés aparte
VITE_API_URL=
